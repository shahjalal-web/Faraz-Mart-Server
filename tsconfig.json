{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // CommonJS, not ESNext: Vercel compiles each file with this tsconfig and
    // runs the output as-is. ESNext kept `import "../src/app"` (no extension,
    // no "type": "module"), which Node can't load → FUNCTION_INVOCATION_FAILED.
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["src", "scripts", "api"],
  "exclude": [
    "node_modules",
    // Deliberately imports across the repo boundary into fazar-mart/data/
    // (a one-time catalog migration) — tsx runs it fine (its only import
    // from there is `import type`, erased at runtime), but tsc would try to
    // resolve fazar-mart's own "@/" alias, which this project doesn't have.
    "scripts/migrate-catalog.ts",
    "scripts/seed-defaults.ts"
  ]
}
